<body class="mat-typography">
  <app-root></app-root>
  <script>
    document.getElementsByTagName('link')["canonical"].href = window.location.origin;

    var appReadyINT = setInterval(function() {
        if(localStorage.getItem("TYPE")) {
            var isHSP = localStorage.getItem("TYPE") === 'HSP';

            if(isHSP) {
                document.getElementsByTagName('meta')["description"].content = "Health Partner Share displays patient data through charts and reports, delivering insights for informed decision-making.";
                document.title = "CareLink™ software for healthcare professionals";
            } else {
                document.getElementsByTagName('meta')["description"].content = "CareLink™ Clinic displays patient data through dashboards, charts, and reports, delivering insights for informed decision-making.";
                document.title = "Diabetes data management for healthcare professionals";
            }
            clearInterval(appReadyINT);
        }
    },100)
</script>
