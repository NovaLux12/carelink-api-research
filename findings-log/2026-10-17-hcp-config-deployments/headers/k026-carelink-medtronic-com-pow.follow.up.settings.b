{
  "limitTimeFrameSeconds": 30,
  "limitEmailsPerHour": 3,
  "limitTimeFrameSecondsForClinic": 60,
  "limitEmailsPerTimeFrameForClinic": 200,
  "limitTemplatesForClinic": 100,
  "urlPattern": "[a-zA-Z]*[^a-zA-Z\\s]*(?i)(https?|ftp|file):\\/\\/[-a-zA-Z0-9+&@#\\/%?=~_|!:,.;]*[a-zA-Z0-9+&@#\\/%=~_|]|[a-zA-Z]*[^a-zA-Z\\s]*(?i)www\\.[-a-zA-Z0-9+&@#\\/%?=~_|!:,.;]*[a-zA-Z0-9+&@#\\/%=~_|]",
  "whitelistDomains": [
    "https://www.medtronic.com",
    "https://www.medtronicdiabetes.com",
    "https://www.medtronic-diabetes.com"
  ],
  "charReplacements": {
    "<": "&lt;",
    ">": "&gt;",
    ":": "&#58;"
  }
}